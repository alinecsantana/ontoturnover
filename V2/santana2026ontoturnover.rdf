        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isSituationalFactorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#InvoluntaryTurnoverRiskContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#RegularIndividualMeetingsWithLeadership -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#RegularIndividualMeetingsWithLeadership">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isSituationalFactorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployerInfluencedRetentionContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#RepeatedJobCrafts -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#RepeatedJobCrafts">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isSituationalFactorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployeeInfluencedRetentionContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#ReplacementDifficulty -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#ReplacementDifficulty">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isConsequenceElementOf"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#EmployerInvoluntaryTurnoverConsequenceContext"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#EmployerVoluntaryTurnoverConsequenceContext"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#Retention -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#Retention">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#DecisionResultingAction"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployeeRetentionConsequenceContext"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployerRetentionConsequenceContext"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#Turnover"/>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#RetentionMotivatingContext -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#RetentionMotivatingContext">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#TurnoverContext"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#hasContextualFactor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#RetentionPotentialFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#contributedToTrigger"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/ontoturnover#StayDecisionMakingEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">All positive workplace, leadership, and individual situations that contribute to triggering an employee&apos;s intention to stay with their current employer.

OntoTurnover/gUFO application: A gufo:Situation context collecting relevant concrete factors through :hasContextualFactor (inverse :isContextualFactorOf). The factors retain their own direct gUFO superclasses and are not subclasses of this context. When an actual contribution is established, this situation may be related by gufo:contributedToTrigger to :StayDecisionMakingEvent. The universal restriction constrains possible targets without asserting that every risk or retention context necessarily produces a decision. Employee and employer influences can coexist in one retention context.

Synonyms: retention-supporting context; stay-motivating situation; continuance context; retention-favorable circumstances; staying context; retention drivers.

References:
- Enander, A., &amp; Cardoso, J. (2020). How is employee turnover related to employee retention? A systematic review on two sets of meta-analyses [Dissertação de mestrado, Lund University]. Lund University Publications. http://lup.lub.lu.se/student-papers/record/9022943/file/9022946.pdf
- Almeida, J. P. A., Guizzardi, G., Sales, T. P., &amp; Falbo, R. A. (2019). gUFO: A Lightweight Implementation of the Unified Foundational Ontology (UFO). https://nemo-ufes.github.io/gufo/
- Guizzardi, R., Carneiro, B. G., Porello, D., &amp; Guizzardi, G. (2020). A core ontology on decision making. CEUR Workshop Proceedings, 2728, 9–21. https://ceur-ws.org/Vol-2728/paper1.pdf</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#RetentionPotentialFactor -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#RetentionPotentialFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividual"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#contributedToTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#StayDecisionMakingEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isContextualFactorOf"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/ontoturnover#RetentionMotivatingContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A potential concrete factor associated with employee retention. The class is grounded in gUFO ConcreteIndividual to accommodate heterogeneous concrete factors that can be included in a retention-motivating pre-state context.

OntoTurnover/gUFO application: This is a heterogeneous grouping of potential contextual factors grounded in gufo:ConcreteIndividual. Specific factor classes retain direct gUFO parents. Their contextual relevance is expressed by :isContextualFactorOf (inverse :hasContextualFactor), not by placing them under this grouping in the explicit hierarchy. An individual may be relevant in more than one context; these groupings are not declared mutually disjoint or disjoint with gufo:Situation or gufo:Event. Only the situation context bears gufo:contributedToTrigger.

Synonyms: retention antecedent; retention driver; retention determinant; stay factor; continuance predictor; retention correlate; retention resource

References:
- Almeida, J. P. A., Guizzardi, G., Sales, T. P., &amp; Falbo, R. A. (2019). gUFO: A Lightweight Implementation of the Unified Foundational Ontology (UFO). https://nemo-ufes.github.io/gufo/
- Santana, A. C., Rodrigues, C. M. de O., Farias Junior, I. H. de, &amp; Santos, W. B. (2023). OntoTurnover: A lightweight domain ontology for modeling employee turnover. In 2023 18th Iberian Conference on Information Systems and Technologies (CISTI) (pp. 1–4). IEEE. https://doi.org/10.23919/CISTI58278.2023.10211799
- Enander, A., &amp; Cardoso, J. (2020). How is employee turnover related to employee retention? A systematic review on two sets of meta-analyses [Master&apos;s thesis, Lund University]. http://lup.lub.lu.se/student-papers/record/9022943/file/9022946.pdf
- Guizzardi, R., Carneiro, B. G., Porello, D., &amp; Guizzardi, G. (2020). A core ontology on decision making. CEUR Workshop Proceedings, 2728, 9–21. https://ceur-ws.org/Vol-2728/paper1.pdf</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#RetiredPerson -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#RetiredPerson">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ontoturnover#LivingPerson"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Retirement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#Retirement -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#Retirement">
