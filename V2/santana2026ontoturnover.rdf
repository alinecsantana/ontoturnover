                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Employee"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#wasCreatedIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#StayDecisionMakingEvent"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#StayIntentionFormation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#manifestedIn"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#Retention"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#StayDecisionMakingEvent"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#IntentionToTerminate"/>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#IntentionToTerminate -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#IntentionToTerminate">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#Intention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#inheresIn"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Employer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#wasCreatedIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#TerminationDecisionMakingEvent"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#TerminationIntentionFormation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#manifestedIn"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#InvoluntaryTurnover"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#TerminationDecisionMakingEvent"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#InterpersonalConflict -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#InterpersonalConflict">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isSituationalFactorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#VoluntaryTurnoverRiskContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#InterpersonalJustice -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#InterpersonalJustice">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isSituationalFactorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployerInfluencedRetentionContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#InvoluntaryTurnover -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#InvoluntaryTurnover">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#Turnover"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployeeInvoluntaryTurnoverConsequenceContext"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#EmployerInvoluntaryTurnoverConsequenceContext"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#VoluntaryTurnover"/>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#InvoluntaryTurnoverPotentialRiskFactor -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#InvoluntaryTurnoverPotentialRiskFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividual"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#contributedToTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#TerminationDecisionMakingEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#isContextualFactorOf"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/ontoturnover#InvoluntaryTurnoverRiskContext"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A potential concrete factor associated with involuntary turnover. The class is grounded in gUFO ConcreteIndividual to accommodate heterogeneous concrete factors relevant to the pre-state preceding an employer termination decision.

OntoTurnover/gUFO application: This is a heterogeneous grouping of potential contextual factors grounded in gufo:ConcreteIndividual. Specific factor classes retain direct gUFO parents. Their contextual relevance is expressed by :isContextualFactorOf (inverse :hasContextualFactor), not by placing them under this grouping in the explicit hierarchy. An individual may be relevant in more than one context; these groupings are not declared mutually disjoint or disjoint with gufo:Situation or gufo:Event. Only the situation context bears gufo:contributedToTrigger.

Synonyms: involuntary-turnover antecedent; dismissal risk factor; termination risk factor; involuntary-separation predictor; discharge determinant; employer-initiated turnover correlate

References:
- Almeida, J. P. A., Guizzardi, G., Sales, T. P., &amp; Falbo, R. A. (2019). gUFO: A Lightweight Implementation of the Unified Foundational Ontology (UFO). https://nemo-ufes.github.io/gufo/
- Santana, A. C., Rodrigues, C. M. de O., Farias Junior, I. H. de, &amp; Santos, W. B. (2023). OntoTurnover: A lightweight domain ontology for modeling employee turnover. In 2023 18th Iberian Conference on Information Systems and Technologies (CISTI) (pp. 1–4). IEEE. https://doi.org/10.23919/CISTI58278.2023.10211799
- Enander, A., &amp; Cardoso, J. (2020). How is employee turnover related to employee retention? A systematic review on two sets of meta-analyses [Master&apos;s thesis, Lund University]. http://lup.lub.lu.se/student-papers/record/9022943/file/9022946.pdf
- Guizzardi, R., Carneiro, B. G., Porello, D., &amp; Guizzardi, G. (2020). A core ontology on decision making. CEUR Workshop Proceedings, 2728, 9–21. https://ceur-ws.org/Vol-2728/paper1.pdf</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#InvoluntaryTurnoverRiskContext -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#InvoluntaryTurnoverRiskContext">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#TurnoverRiskContext"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#hasContextualFactor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#InvoluntaryTurnoverPotentialRiskFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#contributedToTrigger"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/ontoturnover#TerminationDecisionMakingEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#VoluntaryTurnoverRiskContext"/>
        <rdfs:comment xml:lang="en">A gufo:Situation that classifies situations that contribute to triggering an employer&apos;s intention to terminate a contract.

OntoTurnover/gUFO application: A gufo:Situation context collecting relevant concrete factors through :hasContextualFactor (inverse :isContextualFactorOf). The factors retain their own direct gUFO superclasses and are not subclasses of this context. When an actual contribution is established, this situation may be related by gufo:contributedToTrigger to :TerminationDecisionMakingEvent. The universal restriction constrains possible targets without asserting that every risk or retention context necessarily produces a decision. Employee and employer influences can coexist in one retention context.

Synonyms: involuntary-turnover risk situation; dismissal risk context; termination-risk circumstances; involuntary-separation risk configuration; discharge-risk setting

References:
- Enander, A., &amp; Cardoso, J. (2020). How is employee turnover related to employee retention? A systematic review on two sets of meta-analyses [Dissertação de mestrado, Lund University]. Lund University Publications. http://lup.lub.lu.se/student-papers/record/9022943/file/9022946.pdf
- Santana, A. C., Rodrigues, C. M. de O., Farias Junior, I. H. de, &amp; Santos, W. B. (2023). OntoTurnover: A lightweight domain ontology for modeling employee turnover. In 2023 18th Iberian Conference on Information Systems and Technologies (CISTI) (pp. 1–4). IEEE. https://doi.org/10.23919/CISTI58278.2023.10211799
- Santana, A. C., Farias Junior, I. H. de, Santos, W. B., &amp; Rodrigues, C. M. de O. (2023). OntoTurnover: Uma ontologia de domínio sobre a rotatividade de profissionais. In Anais Estendidos do XXII Simpósio Brasileiro de Qualidade de Software (pp. 13–18). Sociedade Brasileira de Computação. https://doi.org/10.5753/sbqsestendido.2023.235887
- Almeida, J. P. A., Guizzardi, G., Sales, T. P., &amp; Falbo, R. A. (2019). gUFO: A Lightweight Implementation of the Unified Foundational Ontology (UFO). https://nemo-ufes.github.io/gufo/
- Guizzardi, R., Carneiro, B. G., Porello, D., &amp; Guizzardi, G. (2020). A core ontology on decision making. CEUR Workshop Proceedings, 2728, 9–21. https://ceur-ws.org/Vol-2728/paper1.pdf</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#JobCrafting -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#JobCrafting">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
