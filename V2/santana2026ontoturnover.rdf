    <!-- http://purl.org/ontoturnover#IntentionToLeave -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#IntentionToLeave">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#Intention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#inheresIn"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Employee"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#wasCreatedIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#LeaveDecisionMakingEvent"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#LeaveIntentionFormation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#manifestedIn"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#LeaveDecisionMakingEvent"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#VoluntaryTurnover"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#IntentionToStay"/>
        <owl:disjointWith rdf:resource="http://purl.org/ontoturnover#IntentionToTerminate"/>
    </owl:Class>
    


