    <!-- http://purl.org/ontoturnover#Turnover -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#Turnover">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontoturnover#DecisionResultingAction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/nemo/gufo#wasTerminatedIn"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Employment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/ontoturnover#TurnoverContext -->

    <owl:Class rdf:about="http://purl.org/ontoturnover#TurnoverContext">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontoturnover#hasContextualFactor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividual"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#contributedToTrigger"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#DecisionMaking"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#IntentionFormation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


