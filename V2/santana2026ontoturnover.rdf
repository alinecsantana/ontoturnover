                            <rdf:Description rdf:about="http://purl.org/ontoturnover#EmployerInvoluntaryTurnoverConsequenceContext"/>
                            <rdf:Description rdf:about="http://purl.org/ontoturnover#EmployerVoluntaryTurnoverConsequenceContext"/>
