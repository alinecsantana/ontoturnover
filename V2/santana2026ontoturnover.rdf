        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#Employer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/ontoturnover#InstitutionalAgent"/>
                    </owl:Restriction>
